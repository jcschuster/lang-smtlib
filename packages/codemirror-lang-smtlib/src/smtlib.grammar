// Generated by gen/bnf2lezer.mjs from spec/smtlib-2.7.bnf, spec/smtlib-2.7.lex and
// gen/overlay.grammar. Do not edit.

// Hand-written part of src/smtlib.grammar. gen/bnf2lezer.mjs adds a rule per production of
// spec/smtlib-2.7.bnf and a token per token class of spec/smtlib-2.7.lex. A @top here
// replaces the production of its name; any other rule named like a production must repeat
// the generated body and only adds its props. gen/CONFLICTS.md explains each entry.

// <script>, plus commands outside the standard (solver extensions).
@top Script { (Command | GenericCommand)* }

@top Responses { GeneralResponse* }

@top TheoryFile { TheoryDecl* }

@top LogicFile { Logic* }

@skip { whitespace | LineComment }

GenericCommand { "(" symbol sExpr* ")" }

// Preferences among readings of an ambiguous response. The generator moves these props
// onto the generated rules.

@external propSource smtlibHighlighting from "./highlight"

@detectDelim

// One rule per production of spec/smtlib-2.7.bnf, in its order.

specConstant {
  ~response Numeral ~response |
  ~response Decimal ~response |
  ~response Hexadecimal ~response |
  ~response Binary ~response |
  ~response String ~response
}

sExpr {
  ~response specConstant ~response |
  ~response symbol ~response |
  ~response reserved ~response |
  ~response Keyword ~response |
  ~response List ~response
}

Index {
  ~response Numeral ~response |
  ~response symbol ~response |
  ~response Hexadecimal ~response
}

Identifier {
  ~response symbol ~response |
  ~response "(" ~response kw<"_"> ~response symbol (~response Index ~response)+ ~response ")" ~response
}

Sort {
  ~response Identifier ~response |
  ~response "(" ~response Identifier (~response Sort ~response)+ ~response ")" ~response
}

AttributeValue {
  ~response specConstant ~response |
  ~response symbol ~response |
  ~response "(" (~response sExpr ~response)* ~response ")" ~response
}

Attribute {
  ~response Keyword ~response |
  ~response Keyword ~response AttributeValue ~response
}

QualIdentifier {
  ~response Identifier ~response |
  ~response "(" ~response kw<"as"> ~response Identifier ~response Sort ~response ")" ~response
}

VarBinding {
  ~response "(" ~response symbol ~response Term ~response ")" ~response
}

SortedVar {
  ~response "(" ~response symbol ~response Sort ~response ")" ~response
}

symbol_ {
  ~response symbol ~response |
  ~response kw<"_"> ~response
}

Pattern {
  ~response symbol_ ~response |
  ~response "(" ~response symbol (~response symbol_ ~response)+ ~response ")" ~response
}

MatchCase {
  ~response "(" ~response Pattern ~response Term ~response ")" ~response
}

Term {
  ~response specConstant ~response |
  ~response QualIdentifier ~response |
  ~response "(" ~response QualIdentifier (~response Term ~response)+ ~response ")" ~response |
  ~response "(" ~response kw<"let"> ~response "(" (~response VarBinding ~response)+ ~response ")" ~response Term ~response ")" ~response |
  ~response "(" ~response kw<"lambda"> ~response "(" (~response SortedVar ~response)+ ~response ")" ~response Term ~response ")" ~response |
  ~response "(" ~response kw<"forall"> ~response "(" (~response SortedVar ~response)+ ~response ")" ~response Term ~response ")" ~response |
  ~response "(" ~response kw<"exists"> ~response "(" (~response SortedVar ~response)+ ~response ")" ~response Term ~response ")" ~response |
  ~response "(" ~response kw<"match"> ~response Term ~response "(" (~response MatchCase ~response)+ ~response ")" ~response ")" ~response |
  ~response "(" ~response kw<"!"> ~response Term (~response Attribute ~response)+ ~response ")" ~response
}

SortSymbolDecl {
  "(" Identifier Numeral Attribute* ")"
}

MetaSpecConstant {
  kw<"NUMERAL"> |
  kw<"DECIMAL"> |
  kw<"STRING">
}

FunSymbolDecl {
  "(" specConstant Sort Attribute* ")" |
  "(" MetaSpecConstant Sort Attribute* ")" |
  "(" Identifier Sort+ Attribute* ")"
}

ParFunSymbolDecl {
  FunSymbolDecl |
  "(" kw<"par"> "(" symbol+ ")" "(" Identifier Sort+ Attribute* ")" ")"
}

TheoryAttribute {
  key<":sorts"> "(" SortSymbolDecl+ ")" |
  key<":funs"> "(" ParFunSymbolDecl+ ")" |
  key<":sorts-description"> String |
  key<":funs-description"> String |
  key<":definition"> String |
  key<":values"> String |
  key<":notes"> String |
  Attribute
}

TheoryDecl {
  "(" sym<"theory"> symbol TheoryAttribute+ ")"
}

LogicAttribute {
  key<":theories"> "(" symbol+ ")" |
  key<":language"> String |
  key<":extensions"> String |
  key<":values"> String |
  key<":notes"> String |
  Attribute
}

Logic {
  "(" sym<"logic"> symbol LogicAttribute+ ")"
}

InfoFlag {
  key<":all-statistics"> |
  key<":assertion-stack-levels"> |
  key<":authors"> |
  key<":error-behavior"> |
  key<":name"> |
  key<":reason-unknown"> |
  key<":version"> |
  Keyword
}

BValue {
  ~response sym<"true"> ~response |
  ~response sym<"false"> ~response
}

Option {
  key<":diagnostic-output-channel"> String |
  key<":global-declarations"> BValue |
  key<":interactive-mode"> BValue |
  key<":print-success"> BValue |
  key<":produce-assertions"> BValue |
  key<":produce-assignments"> BValue |
  key<":produce-models"> BValue |
  key<":produce-proofs"> BValue |
  key<":produce-unsat-assumptions"> BValue |
  key<":produce-unsat-cores"> BValue |
  key<":random-seed"> Numeral |
  key<":regular-output-channel"> String |
  key<":reproducible-resource-limit"> Numeral |
  key<":verbosity"> Numeral |
  Attribute
}

SortDec {
  "(" symbol Numeral ")"
}

SelectorDec {
  "(" symbol Sort ")"
}

ConstructorDec {
  "(" symbol SelectorDec* ")"
}

DatatypeDec {
  "(" ConstructorDec+ ")" |
  "(" kw<"par"> "(" symbol+ ")" "(" ConstructorDec+ ")" ")"
}

FunctionDec {
  ~response "(" ~response symbol ~response "(" (~response SortedVar ~response)* ~response ")" ~response Sort ~response ")" ~response
}

FunctionDef {
  ~response symbol ~response "(" (~response SortedVar ~response)* ~response ")" ~response Sort ~response Term ~response
}

Command {
  "(" kw<"assert"> Term ")" |
  "(" kw<"check-sat"> ")" |
  "(" kw<"check-sat-assuming"> "(" Term* ")" ")" |
  "(" kw<"declare-const"> symbol Sort ")" |
  "(" kw<"declare-datatype"> symbol DatatypeDec ")" |
  "(" kw<"declare-datatypes"> "(" SortDec+ ")" "(" DatatypeDec+ ")" ")" |
  "(" kw<"declare-fun"> symbol "(" Sort* ")" Sort ")" |
  "(" kw<"declare-sort"> symbol Numeral ")" |
  "(" kw<"declare-sort-parameter"> symbol ")" |
  "(" kw<"define-const"> symbol Sort Term ")" |
  "(" kw<"define-fun"> FunctionDef ")" |
  "(" kw<"define-fun-rec"> FunctionDef ")" |
  "(" kw<"define-funs-rec"> "(" FunctionDec+ ")" "(" Term+ ")" ")" |
  "(" kw<"define-sort"> symbol "(" symbol* ")" Sort ")" |
  "(" kw<"echo"> String ")" |
  "(" kw<"exit"> ")" |
  "(" kw<"get-assertions"> ")" |
  "(" kw<"get-assignment"> ")" |
  "(" kw<"get-info"> InfoFlag ")" |
  "(" kw<"get-model"> ")" |
  "(" kw<"get-option"> Keyword ")" |
  "(" kw<"get-proof"> ")" |
  "(" kw<"get-unsat-assumptions"> ")" |
  "(" kw<"get-unsat-core"> ")" |
  "(" kw<"get-value"> "(" Term+ ")" ")" |
  "(" kw<"pop"> Numeral ")" |
  "(" kw<"push"> Numeral ")" |
  "(" kw<"pop"> ")" |
  "(" kw<"push"> ")" |
  "(" kw<"reset"> ")" |
  "(" kw<"reset-assertions"> ")" |
  "(" kw<"set-info"> Attribute ")" |
  "(" kw<"set-logic"> symbol ")" |
  "(" kw<"set-option"> Option ")"
}

ErrorBehavior {
  ~response sym<"immediate-exit"> ~response |
  ~response sym<"continued-execution"> ~response
}

ReasonUnknown {
  ~response sym<"memout"> ~response |
  ~response sym<"incomplete"> ~response |
  ~response sExpr ~response
}

ModelResponse {
  ~response "(" ~response kw<"define-fun"> ~response FunctionDef ~response ")" ~response |
  ~response "(" ~response kw<"define-fun-rec"> ~response FunctionDef ~response ")" ~response |
  ~response "(" ~response kw<"define-funs-rec"> ~response "(" (~response FunctionDec ~response)+ ~response ")" ~response "(" (~response Term ~response)+ ~response ")" ~response ")" ~response
}

InfoResponse {
  ~response key<":assertion-stack-levels"> ~response Numeral ~response |
  ~response key<":authors"> ~response String ~response |
  ~response key<":error-behavior"> ~response ErrorBehavior ~response |
  ~response key<":name"> ~response String ~response |
  ~response key<":reason-unknown"> ~response ReasonUnknown ~response |
  ~response key<":version"> ~response String ~response |
  ~response Attribute ~response
}

ValuationPair {
  ~response "(" ~response Term ~response Term ~response ")" ~response
}

TValuationPair {
  ~response "(" ~response symbol ~response BValue ~response ")" ~response
}

CheckSatResponse {
  ~response sym<"sat"> ~response |
  ~response sym<"unsat"> ~response |
  ~response sym<"unknown"> ~response
}

EchoResponse {
  ~response String ~response
}

GetAssertionsResponse[@dynamicPrecedence=1] {
  ~response "(" (~response Term ~response)* ~response ")" ~response
}

GetAssignmentResponse[@dynamicPrecedence=3] {
  ~response "(" (~response TValuationPair ~response)* ~response ")" ~response
}

GetInfoResponse {
  ~response "(" (~response InfoResponse ~response)+ ~response ")" ~response
}

GetModelResponse {
  ~response "(" (~response ModelResponse ~response)* ~response ")" ~response
}

GetOptionResponse[@dynamicPrecedence=-1] {
  ~response AttributeValue ~response
}

GetProofResponse[@dynamicPrecedence=-2] {
  ~response sExpr ~response
}

GetUnsatAssumpResponse {
  ~response "(" (~response Term ~response)* ~response ")" ~response
}

GetUnsatCoreResponse[@dynamicPrecedence=2] {
  ~response "(" (~response symbol ~response)* ~response ")" ~response
}

GetValueResponse[@dynamicPrecedence=2] {
  ~response "(" (~response ValuationPair ~response)+ ~response ")" ~response
}

SpecificSuccessResponse {
  ~response CheckSatResponse ~response |
  ~response EchoResponse ~response |
  ~response GetAssertionsResponse ~response |
  ~response GetAssignmentResponse ~response |
  ~response GetInfoResponse ~response |
  ~response GetModelResponse ~response |
  ~response GetOptionResponse ~response |
  ~response GetProofResponse ~response |
  ~response GetUnsatAssumpResponse ~response |
  ~response GetUnsatCoreResponse ~response |
  ~response GetValueResponse ~response
}

GeneralResponse {
  ~response sym<"success"> ~response |
  ~response SpecificSuccessResponse ~response |
  ~response sym<"unsupported"> ~response |
  ~response "(" ~response sym<"error"> ~response String ~response ")" ~response
}

List { ~response "(" (~response sExpr ~response)* ~response ")" }

// Reserved words are never symbols; predefined symbols and keywords still are, and win
// where both readings parse.
kw<word> { @specialize[@name={word}]<SimpleSymbol, word> }
sym[@dynamicPrecedence=1]<word> { @extend[@name={word}]<SimpleSymbol, word> }
key[@dynamicPrecedence=1]<word> { @extend[@name={word}]<Keyword, word> }

symbol { SimpleSymbol | QuotedSymbol }

reserved { kw<"!"> | kw<"_"> | kw<"as"> | kw<"BINARY"> | kw<"DECIMAL"> | kw<"exists"> | kw<"HEXADECIMAL"> | kw<"forall"> | kw<"lambda"> | kw<"let"> | kw<"match"> | kw<"NUMERAL"> | kw<"par"> | kw<"STRING"> | kw<"assert"> | kw<"check-sat"> | kw<"check-sat-assuming"> | kw<"declare-const"> | kw<"declare-datatype"> | kw<"declare-datatypes"> | kw<"declare-fun"> | kw<"declare-sort"> | kw<"declare-sort-parameter"> | kw<"define-const"> | kw<"define-fun"> | kw<"define-fun-rec"> | kw<"define-funs-rec"> | kw<"define-sort"> | kw<"echo"> | kw<"exit"> | kw<"get-assertions"> | kw<"get-assignment"> | kw<"get-info"> | kw<"get-model"> | kw<"get-option"> | kw<"get-proof"> | kw<"get-unsat-assumptions"> | kw<"get-unsat-core"> | kw<"get-value"> | kw<"pop"> | kw<"push"> | kw<"reset"> | kw<"reset-assertions"> | kw<"set-info"> | kw<"set-logic"> | kw<"set-option"> }

@tokens {
  Numeral { ("0" | $[1-9] $[0-9]*) }

  Decimal { (("0" | $[1-9] $[0-9]*)) "." "0"* (("0" | $[1-9] $[0-9]*)) }

  Hexadecimal { "#" "x" $[0-9A-Fa-f]+ }

  Binary { "#" "b" $[01]+ }

  String { "\"" (($[\u{9}\u{a}\u{d} !#-~\u{80}-\u{10ffff}] | "\"" "\""))* "\"" }

  SimpleSymbol { $[A-Za-z+\-/*=%?!.$_~&^<>@] $[0-9A-Za-z+\-/*=%?!.$_~&^<>@]* }

  QuotedSymbol { "|" $[\u{9}\u{a}\u{d} -[\]-{}~\u{80}-\u{10ffff}]* "|" }

  Keyword { ":" $[0-9A-Za-z+\-/*=%?!.$_~&^<>@]+ }

  whiteSpaceChar { $[\u{9}\u{a}\u{d} ] }

  LineComment { ";" ![\u{a}\u{d}]* }

  @precedence { Decimal, Numeral }

  whitespace { whiteSpaceChar+ }

  "(" ")"
}
