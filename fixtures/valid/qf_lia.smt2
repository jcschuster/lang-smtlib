; Linear integer arithmetic: let, ite, distinct, the assertion stack (also (push) and (pop)
; without a numeral, a deviation, spec/README.md), and assumptions.
; oracle: z3 cvc5
(set-option :produce-unsat-assumptions true)
(set-logic QF_LIA)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-const p Bool)
(define-fun max ((a Int) (b Int)) Int (ite (>= a b) a b))
(assert (let ((s (+ x y)) (d (- x y))) (and (<= 0 d) (< d 10) (= (max s d) s))))
(assert (distinct x y (- 3)))
(push 1)
(assert (=> p (> (* 2 x) (+ y 7))))
(check-sat)
(pop 1)
(push)
(assert (< x 0))
(pop)
(check-sat-assuming ((> x 100) (not (> x 50))))
(get-unsat-assumptions)
(check-sat-assuming (p (not p)))
(exit)
