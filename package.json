    "build": "pnpm -r run build",
    "test": "node --test gen/ && pnpm -r test"
  },
  "license": "MIT",
  "engines": {
    "node": "^26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@lezer/generator": "^1.8.1"
  }
}
